# Configuration for nftraffle.
#
# Copy to .env.local for development, and set the same names in the Vercel
# project for production.
#
# TWO RULES GOVERN THIS FILE.
#
# 1. NOTHING HERE HAS A PLACEHOLDER VALUE. Not a wallet, not a fee, not an RPC
#    URL. A placeholder wallet address is an address — it receives — and a
#    deployment that goes live with one collects real SOL into a wallet nobody
#    holds the key to, with no way for the payer to know. Every variable below
#    is either set to something real or left empty.
#
# 2. AN EMPTY VALUE IS A SUPPORTED STATE, NOT A BROKEN ONE. The surfaces that
#    need a variable close with their own screen and say nothing has been
#    charged (src/lib/surfaces.ts). Read-only pages keep working. So a fresh
#    deployment is a readable site that cannot yet take money, which is exactly
#    what it should be.

# --- Database ---------------------------------------------------------------

# Postgres for the app, in every environment. Neon, branch `production`.
#
# Required, no default: a fallback would mean running against the wrong
# database rather than failing. Keep sslmode=verify-full — `require` encrypts
# but authenticates nothing, so it stops eavesdropping and not impersonation.
DATABASE_URL=

# Postgres for the TEST SUITE and nothing else. Neon, branch `tests`.
#
# Deliberately a different variable and a different branch. The suite truncates
# every table between tests, so this must point at a database that is
# disposable on purpose.
#
# TWO GUARDS STAND BETWEEN THIS AND A DISASTER, and they answer different
# questions. `vitest.setup.ts` refuses if this equals DATABASE_URL — that
# catches "same database twice". `vitest.global-setup.ts` refuses unless the
# database carries a `disposable_database` table — that catches "wrong
# database", and is the absolute question the first one cannot answer when
# DATABASE_URL is unset. The stamp is written ONLY by `npm run db:migrate:test`
# and deliberately NOT by a migration, because a migration runs against
# production too, which is exactly backwards.
TEST_DATABASE_URL=

# --- Identity and rate limiting ---------------------------------------------

# Salt for hashing caller IP addresses.
#
# REQUIRED in production. An unsalted SHA-256 of an IPv4 address is reversible
# by brute force — four billion preimages — so the stored hashes would be
# visitor IP addresses in all but name.
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Allow requests with no trustworthy client address. Local development only.
# It must stay unset in production, where no client address means no rate
# limiting at all.
# ALLOW_UNTRUSTED_CLIENT_IP=true

# How many proxies sit in front of this app and append to x-forwarded-for.
# Default 1, which matches Vercel.
#
# The header is read from the RIGHT, not the left: proxies APPEND to it, so the
# left-most entry is whatever the caller sent. Reading the left would let
# anyone pick their own rate-limit bucket with a forged header.
# TRUSTED_PROXY_HOPS=1

# Which inbound header, if any, this deployment's edge overwrites with the
# caller's real address — and therefore the only header trusted ahead of
# x-forwarded-for. Unset means trust nothing but our own proxy chain: every
# other candidate header is an ordinary inbound header a caller can set to
# anything, including somebody else's bucket. On Vercel, set this to
# x-vercel-forwarded-for.
# TRUSTED_PLATFORM_HEADER=x-vercel-forwarded-for

# This deployment's public origin, used by the cross-site POST guard. Falling
# back to the request's Host keeps local development working without it.
# SITE_URL=https://example.com

# --- Solana -----------------------------------------------------------------

# RPC endpoint(s), comma-separated and tried in order.
#
# NO DEFAULT, and this differs from the sibling projects on purpose. They fell
# back to the public mainnet endpoint; this project cannot, because it needs
# DAS methods (getAsset, getAssetsByOwner, getAssetsByGroup) for every image
# and every ownership check, and the public node does not serve them. A silent
# fallback would fail the launchpad and raffle paths in a way that reads as a
# bug rather than as missing configuration.
#
# The HOSTNAME decides whether signing is offered at all. `classifyEndpoint` in
# src/lib/chain/cluster.ts reads the cluster out of the host and path — never
# the query string, which is where a provider's key lives — and a URL it cannot
# classify answers `unknown`, which BLOCKS signing rather than guessing
# mainnet:
#
#   https://mainnet.helius-rpc.com/?api-key=...   -> solana:mainnet, signs
#   https://rpc.helius.xyz/?api-key=...           -> unknown, blocks
#
# Same provider, same key, same cluster. Only the host differs. Refusing is the
# deliberate half: this product asks creators to sign transactions that create
# PERMANENT on-chain state, and a collection minted on devnet is not undoable.
SOLANA_RPC_URL=

# The wallet that receives ticket payments, listing fees and launch fees.
#
# REQUIRED for any surface that takes money, no default and never a
# placeholder. This project only ever RECEIVES: it holds no private key for
# this wallet and never signs with it.
#
# MUST BE A NEW WALLET, EXCLUSIVE TO THIS PROJECT. Not a wallet another project
# uses. Ticket payments are matched by signature and window, and sharing a
# receiving wallet across projects means two verifiers looking at the same
# transfers.
PAYMENT_WALLET=

# The wallet that holds raffle prizes between deposit and payout.
#
# The one wallet in this product that holds somebody else's property. Its
# private key is not in this repository, not on the server, and not reachable
# by any code path here — every transfer out of it is made by a human, and this
# codebase's only job is to verify that it happened.
#
# MUST ALSO BE A NEW WALLET, EXCLUSIVE TO THIS PROJECT, and a DIFFERENT one
# from PAYMENT_WALLET. Keeping fees and custodied assets in one wallet makes
# "what do we actually owe people" an unanswerable question at exactly the
# moment somebody asks it.
ESCROW_WALLET=

# --- Fees -------------------------------------------------------------------
#
# ALL FOUR HAVE NO DEFAULTS, ANYWHERE — not in code and not in copy.
#
# The rule is DESIGN.md §8.2 and it is stricter than the sibling project's,
# which defaulted its fee. The difference is that a default here would be
# quoted in a sentence on a screen where somebody is deciding whether to launch
# or list, and a number in copy that nothing enforces is the exact defect that
# rule exists to prevent. A missing fee closes its surface instead.
#
# ZERO IS VALID AND IT IS THE DOOR. Set any of these to 0 and the fee switches
# off with a variable and no deploy — which is what makes "the fee is killing
# the volume" a one-minute change instead of a release. Unset is a DIFFERENT
# thing from zero: unset closes the surface, zero opens it for free.

# Charged once, in SOL, to create a collection and its candy machine.
LAUNCH_FEE_SOL=

# The platform's share of each mint, in whole basis points (100 = 1%).
#
# Applied as the candy machine's `solFixedFee` guard, not as an instruction our
# client appends — see the spec §0.1. An appended instruction is enforced by
# our client code, and our client code is not in the enforcement path: the
# candy machine is a public account and a minter who assembles their own
# transaction simply omits it. The guard is evaluated by the program itself.
#
# CONSEQUENCE WORTH KNOWING BEFORE YOU CHANGE IT: the guard takes fixed
# lamports, so this is converted at candy-machine creation and FROZEN for that
# machine's life. Changing it reaches collections launched afterwards, never
# live ones. Each row records what it actually charges.
MINT_FEE_BPS=

# Charged once, in SOL, to list a raffle. Antibot as much as revenue.
RAFFLE_LISTING_FEE_SOL=

# The house's share of a raffle's ticket sales, in whole basis points.
#
# Frozen per raffle when the seller lists, for the same reason: a seller
# decided to list against this number, and a later change must not reach back
# and take more of a sale they already agreed to.
HOUSE_FEE_BPS=

# --- Admin ------------------------------------------------------------------

# The admin token.
#
# FAILS CLOSED. With this unset there is no admin surface at all: not an open
# one, not a partly open one, and not one a live session cookie minted while it
# was set can still get into. Clearing it is also how an operator kills every
# live session in a hurry — the cost being that the whole surface goes down
# with them, because there is no revoke-any-session control (see
# src/lib/admin.ts).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Optional ---------------------------------------------------------------

# Where somebody whose payment could not be applied is told to go.
#
# DECIDED (docs/decisions.md Q6): the same convention the sibling projects use —
# a `support@` inbox on this project's own domain, e.g. bidoor uses
# support@bidoor.lol and pixelwar uses support@pixelwar.fun. There is no single
# shared mailbox across the three; each is its own address on its own domain.
#
# LEFT EMPTY HERE ON PURPOSE. This project has no domain yet, so there is no
# real address to write, and writing support@<working-name> would be exactly the
# placeholder the top of this file forbids — an address that looks routable and
# is not, printed to somebody whose money is missing. Set it the day the domain
# is bought.
#
# Unset is a supported state: the copy degrades to "this has been recorded"
# rather than inventing a channel.
SUPPORT_CONTACT=

# Ticket orders one address may open per window. Defaults: 20 per 10 minutes.
# ORDER_RATE_LIMIT_MAX=20
# ORDER_RATE_LIMIT_WINDOW_MINUTES=10

# Calls one address may make to /api/rpc per window. Defaults: 120 per 60s.
# RPC_RATE_LIMIT_MAX=120
# RPC_RATE_LIMIT_WINDOW_SECONDS=60

# Postgres pool size per serverless instance. Default 10.
# DATABASE_POOL_MAX=10
